# Pozn.: žádné globální „/* X-Robots-Tag: index, follow" – indexace je výchozí
# a Cloudflare při shodě více pravidel hodnoty spojuje čárkou („index, follow,
# noindex"), takže by noindex níže byl v rozporu s globálním pravidlem.

# Strojově čitelné soubory pro agenty – nemají co dělat ve výsledcích hledání
# (GSC hlásilo oauth-protected-resource jako „Procházeno – neindexováno").
# Agenti je čtou dál, noindex jim nebrání.
/.well-known/*
  X-Robots-Tag: noindex

# Soubory s hashem v názvu (/_next/static/*) jsou neměnné – při změně obsahu se mění
# i název. OpenNext je ale servíruje s „max-age=0, must-revalidate", takže se každý
# JS, CSS i font při každé návštěvě znovu ověřuje. Měření 16. 10. (Slow 4G, 4× CPU):
# CSS bundle blokuje vykreslení a stahuje se 3,1 s. Rok s immutable to u vracejících
# se návštěvníků odstraní úplně.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Skrytá admin sekce – nikdy neindexovat.
/sprava
  X-Robots-Tag: noindex, nofollow
/sprava/*
  X-Robots-Tag: noindex, nofollow

/
  Link: </llms.txt>; rel="service-doc", </.well-known/api-catalog>; rel="api-catalog", </.well-known/openid-configuration>; rel="openid-configuration", </.well-known/oauth-protected-resource>; rel="oauth-protected-resource", </.well-known/agent-card.json>; rel="agent-card"
  Vary: Accept

